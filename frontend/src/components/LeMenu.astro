---
import { Image } from 'astro:assets';
import { STRAPI_URL, fetchStrapiData, blocksToHtml } from '../lib/strapi';
import type { StrapiBlock } from '../lib/strapi';

const data = await fetchStrapiData('/api/le-menu?populate[Carte][populate]=Photo');

const titreHtml = data?.Titre_section ? blocksToHtml(data.Titre_section) : '';
const infosComplementairesHtml = data?.Informations_complementaires ? blocksToHtml(data.Informations_complementaires) : '';

type Carte = {
  Etape?: string;
  Infos?: string;
  Texte?: StrapiBlock[];
  Photo?: { url: string };
  Description_photo?: string;
};

const cartes: Carte[] = data?.Carte ?? [];
---

<section class="le-menu">
  {titreHtml && (
    <div class="section-header">
      <Fragment set:html={titreHtml} />
    </div>
  )}
  <div class="cards-container">
    {cartes.map((carte) => (
      <div class="card-wrapper">
        {carte.Etape && <span class="card-label">{carte.Etape}</span>}
        <div class="card-inner">
          <div class="card-front">
            {carte.Texte && <Fragment set:html={blocksToHtml(carte.Texte)} />}
          </div>
          <div class="card-back">
            {carte.Photo?.url && (
              <Image
                src={`${STRAPI_URL}${carte.Photo.url}`}
                width={500}
                inferSize
                alt={carte.Description_photo ?? ''}
                class="card-photo"
              />
            )}
          </div>
        </div>
        {carte.Infos && <span class="card-label">{carte.Infos}</span>}
      </div>
    ))}
  </div>
  {infosComplementairesHtml && (
    <div class="section-footer">
      <Fragment set:html={infosComplementairesHtml} />
    </div>
  )}
</section>

<style>
  .le-menu {
    background-color: var(--color-white);
    padding: 4rem 2rem;
  }

  .section-header,
  .section-footer {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-footer {
    margin-top: 3rem;
  }

  .section-header :global(h2),
  .section-header :global(h3),
  .section-footer :global(h2),
  .section-footer :global(h3) {
    font-size: 2rem;
    color: var(--color-text);
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .section-header :global(p),
  .section-footer :global(p) {
    color: var(--color-text);
    line-height: 1.8;
  }

  .cards-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4rem;
    flex-wrap: wrap;
  }

  /* Card dimensions: 58% of ~431px photo width = ~250px; poker ratio 5:7 → 350px tall */
  .card-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .card-inner {
    width: 250px;
    height: 350px;
    position: relative;
  }

  .card-front,
  .card-back {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    transition: opacity 350ms ease, transform 350ms ease;
  }

  .card-front {
    background-color: var(--color-orange);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
    z-index: 2; /* text on top by default */
  }

  .card-front :global(p) {
    line-height: 1.7;
    font-size: 1rem;
    margin: 0;
  }

  .card-back {
    opacity: 0;
    transform: scale(0.97);
    z-index: 1;
  }

  .card-inner.show-image .card-back {
    opacity: 1;
    transform: scale(1);
    z-index: 2;
  }

  .card-inner.show-image .card-front {
    opacity: 0;
    transform: scale(0.97);
    z-index: 1;
  }

  .card-label {
    color: var(--color-text);
    font-size: 1.6rem;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
  }

  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  @media (max-width: 768px) {
    .le-menu {
      padding-top: 5rem;
    }
  }
</style>

<script>
  const today = new Intl.DateTimeFormat('fr-FR', {
    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
  }).format(new Date());

  document.querySelector('.le-menu .section-header')?.querySelectorAll('*').forEach(el => {
    el.childNodes.forEach(node => {
      if (node.nodeType === Node.TEXT_NODE && node.textContent?.includes('{{date}}')) {
        node.textContent = node.textContent.replace('{{date}}', today);
      }
    });
  });

  const wrappers = Array.from(document.querySelectorAll<HTMLElement>('.le-menu .card-wrapper'));

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      wrappers.forEach((wrapper, i) => {
        const inner = wrapper.querySelector('.card-inner') as HTMLElement;
        setTimeout(() => {
          inner.classList.add('show-image');
        }, 1000 + i * 230);
      });
      observer.disconnect();
    }
  }, { threshold: 0.3 });

  const container = document.querySelector('.le-menu .cards-container');
  if (container) observer.observe(container);

  wrappers.forEach(wrapper => {
    const inner = wrapper.querySelector('.card-inner') as HTMLElement;
    wrapper.addEventListener('mouseenter', () => {
      inner.classList.remove('show-image');
    });
  });
</script>
