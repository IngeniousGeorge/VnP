---
import { Image } from 'astro:assets';
import { STRAPI_URL, blocksToHtml } from '../lib/strapi';

let data;
try {
  const res = await fetch(`${STRAPI_URL}/api/le-menu?populate[Carte][populate]=Photo`);
  const json = await res.json();
  data = json.data;
} catch (e) {
  console.error('Failed to fetch Le Menu from Strapi:', e);
}

const today = new Intl.DateTimeFormat('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
}).format(new Date());

const titreHtml = data?.Titre_section
  ? blocksToHtml(data.Titre_section).replace('{{date}}', today)
  : '';

const cartes: Array<{
  Etape?: string;
  Texte?: any[];
  Photo?: { url: string };
  Description_photo?: string;
}> = data?.Carte ?? [];
---

<section class="le-menu">
  {titreHtml && (
    <div class="section-header">
      <Fragment set:html={titreHtml} />
    </div>
  )}
  <div class="cards-container">
    {cartes.map((carte) => (
      <div class="card-wrapper">
        {carte.Etape && <span class="card-label">{carte.Etape}</span>}
        <div class="card-inner">
          <div class="card-front">
            {carte.Texte && <Fragment set:html={blocksToHtml(carte.Texte)} />}
          </div>
          <div class="card-back">
            {carte.Photo?.url && (
              <Image
                src={`${STRAPI_URL}${carte.Photo.url}`}
                width={500}
                inferSize
                alt={carte.Description_photo ?? ''}
                class="card-photo"
              />
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .le-menu {
    background-color: var(--color-gray-bg);
    padding: 4rem 2rem;
  }

  .section-header {
    max-width: 900px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .section-header :global(h2),
  .section-header :global(h3) {
    font-size: 2rem;
    color: var(--color-white);
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .section-header :global(p) {
    color: var(--color-white);
    line-height: 1.8;
  }

  .cards-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4rem;
    flex-wrap: wrap;
  }

  /* Card dimensions: 58% of ~431px photo width = ~250px; poker ratio 5:7 → 350px tall */
  .card-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    perspective: 1000px;
    flex-shrink: 0;
  }

  .card-inner {
    width: 250px;
    height: 350px;
    position: relative;
  }

  .card-front,
  .card-back {
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }

  .card-front {
    background-color: var(--color-orange);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
  }

  .card-front :global(p) {
    line-height: 1.7;
    font-size: 1rem;
    margin: 0;
  }

  .card-back {
    z-index: 1;
  }

  .card-label {
    color: var(--color-white);
    font-size: 1.6rem;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
  }

  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }
</style>
