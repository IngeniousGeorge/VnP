---
import { Image } from 'astro:assets';

interface Props {
  titre: string;
  texteHtml: string;
  photoUrl: string | null;
  photoAlt: string;
  miseEnValeur?: string;
  withOffset?: boolean;
  darkBg?: boolean;
  darkerBg?: boolean;
  reversed?: boolean;
  photoWidth?: number;
  photoHeight?: number;
}

const { titre, texteHtml, photoUrl, photoAlt, miseEnValeur, withOffset = false, darkBg = false, darkerBg = false, reversed = false, photoWidth, photoHeight } = Astro.props;

const isLandscape = photoWidth && photoHeight ? photoWidth > photoHeight : false;
---

<section class:list={['photo-text-section', { 'with-offset': withOffset, 'dark-bg': darkBg, 'darker-bg': darkerBg, 'reversed': reversed, 'landscape': isLandscape }]}>
  <div class="container">
    <div class="image-container">
      {photoUrl && <Image src={photoUrl} width={800} inferSize alt={photoAlt} class="section-photo" />}
    </div>
    <div class="content">
      {titre && <h2>{titre}</h2>}
      <Fragment set:html={texteHtml} />
      {miseEnValeur && <p class="highlight">{miseEnValeur}</p>}
    </div>
  </div>
</section>

<style>
  .photo-text-section {
    background-color: var(--color-white);
    padding: 4rem 2rem;
  }

  .photo-text-section.with-offset {
    padding-top: calc(4rem + 24px);
  }

  .photo-text-section.dark-bg {
    background-color: var(--color-gray-bg);
    color: var(--color-white);
  }

  .photo-text-section.dark-bg h2 {
    color: var(--color-white);
  }

  .photo-text-section.darker-bg {
    background-color: var(--color-dark-bg);
    color: var(--color-white);
  }

  .photo-text-section.darker-bg h2 {
    color: var(--color-white);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .photo-text-section.landscape .container {
    grid-template-columns: 58fr 42fr;
  }

  .photo-text-section.landscape.reversed .container {
    grid-template-columns: 42fr 58fr;
  }

  /* Photo on the right: push image-container after content */
  .photo-text-section.reversed .image-container {
    order: 2;
  }

  .section-photo {
    width: 82%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
    display: block;
    margin: 0 auto;
  }

  .content {
    padding: 1rem;
  }

  h2 {
    font-size: 2rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  strong {
    font-weight: 700;
  }

  /* set:html bypasses Astro scoping — :global() required */
  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    margin-top: 0;
    margin-bottom: 1.4rem;
    line-height: 1.8;
  }

  .content :global(p) {
    margin-bottom: 1.4rem;
    line-height: 1.8;
    text-align: justify;
  }

  .highlight {
    font-style: italic;
    color: var(--color-orange-dark);
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .content {
      order: -1;
    }

    h2 {
      font-size: 1.75rem;
    }
  }
</style>
