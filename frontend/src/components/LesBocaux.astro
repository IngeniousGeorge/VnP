---
import { STRAPI_URL, blocksToHtml } from '../lib/strapi';

let data;
try {
  const res = await fetch(`${STRAPI_URL}/api/les-bocaux?populate=Photo`);
  const json = await res.json();
  data = json.data;
} catch (e) {
  console.error('Failed to fetch Les Bocaux from Strapi:', e);
}

const titre        = data?.Titre            ?? 'Les Bocaux';
const texteHtml    = data?.Texte            ? blocksToHtml(data.Texte) : '';
const miseEnValeur = data?.Mise_en_valeur   ?? '';
const photoUrl     = data?.Photo?.url       ? `${STRAPI_URL}${data.Photo.url}` : null;
const photoAlt     = data?.Description_photo ?? '';
---

<section class="les-bocaux">
  <div class="container">
    <div class="image-container">
      {photoUrl && <img src={photoUrl} alt={photoAlt} class="les-bocaux-photo" />}
    </div>
    <div class="content">
      <h2>{titre}</h2>
      <Fragment set:html={texteHtml} />
      {miseEnValeur && <p class="highlight">{miseEnValeur}</p>}
    </div>
  </div>
</section>

<style>
  .les-bocaux {
    background-color: var(--color-white);
    padding: 4rem 2rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .les-bocaux-photo {
    width: 82%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
    display: block;
    margin: 0 auto;
  }

  .content {
    padding: 1rem;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  /* set:html bypasses Astro scoping — :global() required */
  .content :global(p) {
    margin-bottom: 1.4rem;
    line-height: 1.8;
    text-align: justify;
  }

  .highlight {
    font-style: italic;
    color: var(--color-orange-dark);
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .content {
      order: -1;
    }

    h2 {
      font-size: 1.75rem;
    }
  }
</style>
