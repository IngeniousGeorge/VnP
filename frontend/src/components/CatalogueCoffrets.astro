---
import { Image } from 'astro:assets';
import { STRAPI_URL, fetchStrapiData, blocksToHtml } from '../lib/strapi';

const data = await fetchStrapiData('/api/catalogue-coffrets?populate[Coffret][populate]=Photo');

const titreHtml = data?.Titre_section ? blocksToHtml(data.Titre_section) : '';

type Carte = {
  Type?: string;
  Photo?: { url: string };
  Description_photo?: string;
};

const cartes: Carte[] = data?.Coffret ?? [];
---

<section class="catalogue-coffrets">
  {titreHtml && (
    <div class="section-header">
      <Fragment set:html={titreHtml} />
    </div>
  )}
  <div class="cards-container">
    {cartes.map((carte) => (
      <div class="card-wrapper">
        {carte.Type && <span class="card-label">{carte.Type}</span>}
        <div class="card-inner" data-full-src={carte.Photo?.url ? `${STRAPI_URL}${carte.Photo.url}` : undefined} data-alt={carte.Description_photo ?? ''}>
          {carte.Photo?.url && (
            <Image
              src={`${STRAPI_URL}${carte.Photo.url}`}
              width={500}
              inferSize
              alt={carte.Description_photo ?? ''}
              class="card-photo"
            />
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<dialog id="coffret-lightbox">
  <img id="coffret-lightbox-img" src="" alt="" />
</dialog>

<style>
  .catalogue-coffrets {
    background-color: var(--color-gray-bg);
    padding: 4rem 2rem;
  }

  .section-header {
    max-width: 900px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .section-header :global(h2),
  .section-header :global(h3) {
    font-size: 2rem;
    color: var(--color-white);
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .section-header :global(p) {
    color: var(--color-white);
    line-height: 1.8;
  }

  .cards-container {
    max-width: 62rem;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .card-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  /* Card dimensions: 275×315px (17.1875rem × 19.6875rem at 16px base) */
  .card-inner {
    width: 17.1875rem;
    height: 19.6875rem;
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: pointer;
  }

  #coffret-lightbox {
    padding: 0;
    background: transparent;
    border: none;
    outline: none;
    width: 90vw;
    height: 90vh;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  #coffret-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
    cursor: pointer;
  }

  #coffret-lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    cursor: pointer;
  }

  .card-label {
    color: var(--color-white);
    font-size: 1.6rem;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
  }

  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script>
  const dialog = document.getElementById('coffret-lightbox') as HTMLDialogElement;
  const lightboxImg = document.getElementById('coffret-lightbox-img') as HTMLImageElement;

  document.querySelectorAll('.catalogue-coffrets .card-inner').forEach(card => {
    card.addEventListener('click', () => {
      const fullSrc = (card as HTMLElement).dataset.fullSrc;
      if (!fullSrc) return;
      lightboxImg.src = fullSrc;
      lightboxImg.alt = (card as HTMLElement).dataset.alt ?? '';
      dialog.showModal();
    });
  });

  dialog.addEventListener('click', () => dialog.close());
</script>
