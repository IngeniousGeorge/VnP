---
import { Image } from 'astro:assets';
import { fetchStrapiData, buildPhotoUrl, blocksToHtml } from '../lib/strapi';

const data = await fetchStrapiData('/api/la-boutique?populate=Photo');

const titre        = data?.Titre            ?? 'La boutique';
const texteHtml    = data?.Texte            ? blocksToHtml(data.Texte) : '';
const miseEnValeur = data?.Mise_en_valeur   ?? '';
const photoUrl     = buildPhotoUrl(data?.Photo);
const photoAlt     = data?.Description_photo ?? '';
---

<section class="la-boutique">
  <div class="container">
    <div class="content">
      <h2>{titre}</h2>
      <Fragment set:html={texteHtml} />
      {miseEnValeur && <p class="highlight">{miseEnValeur}</p>}
    </div>

    <div class="image-container">
      {photoUrl && <Image src={photoUrl} width={800} inferSize alt={photoAlt} class="boutique-photo" />}
    </div>
  </div>
</section>

<style>
  .la-boutique {
    background-color: var(--color-white);
    padding: 4rem 2rem;
    color: var(--color-text);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .content {
    padding: 1rem 0;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  /* set:html bypasses Astro scoping — :global() required */
  .content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.8;
    text-align: justify;
  }

  strong {
    font-weight: 700;
  }

  .highlight {
    font-style: italic;
    color: var(--color-orange-dark);
    margin-top: 1.5rem;
  }

  .boutique-photo {
    width: 82%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    h2 {
      font-size: 1.75rem;
    }
  }
</style>
