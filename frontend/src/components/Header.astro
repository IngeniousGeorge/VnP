---
interface Props {
  navOnly?: boolean;
}

const { navOnly = false } = Astro.props;

import { Image, getImage } from 'astro:assets';
import { fetchStrapiData, blocksToHtml, buildPhotoUrl } from '../lib/strapi';
import logo from '../assets/images/logo_vp.png';
import bannerSrc from '../assets/images/banner.jpg';

const bannerBg = await getImage({ src: bannerSrc, width: 1920 });
const annonce  = navOnly ? null : await fetchStrapiData('/api/annonce?populate=Image');
const texteHtml      = annonce?.Texte           ? blocksToHtml(annonce.Texte) : '';
const lienLibelle    = annonce?.Texte_du_lien   ?? '';
const lienUrl        = annonce?.Adresse_du_lien ?? '';
const texteImage     = annonce?.Texte_lien_image ?? '';
const imageUrl       = buildPhotoUrl(annonce?.Image);
---

<!-- Shared SVG defs: Instagram gradient referenced by both icons below -->
<svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
  <defs>
    <linearGradient id="ig-gradient" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0%" stop-color="#F58529"/>
      <stop offset="50%" stop-color="#DD2A7B"/>
      <stop offset="100%" stop-color="#8134AF"/>
    </linearGradient>
  </defs>
</svg>

