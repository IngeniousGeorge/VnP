  <div class="banner-container">
    {!navOnly && (
      <Fragment>
        <a href="/" class="logo">
          <Image src={logo} alt="Verre et Papilles" width={200} height={200} />
        </a>

        <nav class="banner-nav">
          <a href="https://www.instagram.com/verre_et_papilles" target="_blank" rel="noopener noreferrer" class="banner-nav-link banner-social" aria-label="Instagram">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/verreetpapilles" target="_blank" rel="noopener noreferrer" class="banner-nav-link banner-social" aria-label="Facebook">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href="/contact" class="banner-nav-link banner-cta">contact & infos</a>
        </nav>
