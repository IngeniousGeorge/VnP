      <a href="/" class="navbar-logo-link">
        <Image src={logo} alt="Accueil" width={192} height={192} class="navbar-logo" />
      </a>
      <a href="/bocaux" class="navbar-link">Les bocaux</a>
      <span class="navbar-separator">|</span>
      <a href="/crottin" class="navbar-link">Le crottin</a>
      <span class="navbar-separator">|</span>
      <a href="/coffrets" class="navbar-link">Les coffrets</a>
      <span class="navbar-separator">|</span>
      <a href="/contact" class="navbar-link navbar-link--contact">Contact & infos</a>
      <span class="navbar-separator navbar-sep--phone">|</span>
      <a href="tel:+33243078905" class="navbar-link navbar-link--phone">02 43 07 89 05</a>
      <span class="navbar-separator navbar-sep--social">|</span>
      <div class="navbar-social">
        <a href="https://www.instagram.com/verre_et_papilles" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="url(#ig-gradient)"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="url(#ig-gradient)"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="url(#ig-gradient)"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/verreetpapilles" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-facebook)" stroke-width="2">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
      </div>
    </nav>

    <!-- Mobile navigation bar (≤768px only) -->
    <nav class="mobile-nav-bar" style={`background-image: url(${bannerBg.src});`}>
      <a href="/" class="mobile-nav-logo">
        <Image src={logo} alt="Verre et Papilles" width={282} height={282} />
      </a>
      <div class="mobile-nav-actions">
        <a href="tel:+33243078905" class="mobile-action-icon" aria-label="Téléphone">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </a>
        <button class="mobile-action-icon mobile-menu-toggle" aria-label="Menu">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>
<div class="banner-spacer"></div>

<!-- Mobile drawer navigation -->
<nav class="mobile-drawer">
  <button class="drawer-close" aria-label="Fermer">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <ul class="drawer-menu">
    <li><a href="/">Verre et Papilles</a></li>
    <li><a href="/bocaux">Les Bocaux du Jour</a></li>
    <li><a href="/crottin">Le Crottin Craonnais</a></li>
    <li><a href="/coffrets">Les Coffrets Gourmands</a></li>
    <li><a href="/contact">Contact & Infos</a></li>
    <li><a href="tel:+33243078905">02 43 07 89 05</a></li>
    <li class="drawer-social">
      <a href="https://www.instagram.com/verre_et_papilles" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="url(#ig-gradient)"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="url(#ig-gradient)"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="url(#ig-gradient)"/>
        </svg>
      </a>
      <a href="https://www.facebook.com/verreetpapilles" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-facebook)" stroke-width="2">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>
    </li>
  </ul>
</nav>
  </div>
</header>
<div class="banner-spacer"></div>
{!navOnly && (texteHtml ? (
  <div class="announcement-bar">
    <div class="announcement-content">
      <div class="announcement-text" set:html={texteHtml} />
      {lienLibelle && lienUrl && (
        <a href={lienUrl} class="announcement-link">{lienLibelle}</a>
      )}
      {texteImage && imageUrl && (
        <button class="announcement-lightbox-btn" data-src={imageUrl}>{texteImage}</button>
      )}
    </div>
  </div>
) : (
  <div class="announcement-spacer"></div>
))}

<dialog id="annonce-lightbox">
  <img id="annonce-lightbox-img" src="" alt="" />
</dialog>

<script>
  const banner = document.querySelector('.banner') as HTMLElement;
  const spacer = document.querySelector('.banner-spacer') as HTMLElement;
  const logoEl = banner.querySelector('.logo') as HTMLElement | null;
  const isMobile = window.matchMedia('(max-width: 768px)').matches;
  const isNavOnly = banner.classList.contains('banner--nav-only');

  // Mobile drawer toggle
  if (isMobile) {
    const drawer = document.querySelector('.mobile-drawer') as HTMLElement;
    const menuToggle = document.querySelector('.mobile-menu-toggle') as HTMLElement;
    const drawerClose = document.querySelector('.drawer-close') as HTMLElement;

    if (drawer && menuToggle && drawerClose) {
      menuToggle.addEventListener('click', () => {
        drawer.classList.add('open');
        document.body.style.overflow = 'hidden';
      });

      drawerClose.addEventListener('click', () => {
        drawer.classList.remove('open');
        document.body.style.overflow = '';
      });
    }
  }

  if (isMobile) {
    // Mobile: spacer clears the logo overflow + small breathing room
    spacer.style.height = '72px';
  } else if (isNavOnly) {
    // navOnly mode (desktop): sticky navbar is always visible at the top
    const nav = banner.querySelector('.sticky-navbar') as HTMLElement;
    if (nav) {
      const navHeight = nav.offsetHeight;
      spacer.style.height = navHeight + 'px';
    }
  } else {
    // Desktop: the navbar is hidden inside the banner and becomes sticky only
    // after the user has scrolled past the full banner height.
    const FADE_THRESHOLD = 0.7; // logo starts fading at 70% of banner height scrolled
    const bannerHeight = banner.offsetHeight;
    const fadeStart = bannerHeight * FADE_THRESHOLD;
    let isSticky = false;

    function onScroll() {
      const y = window.scrollY;
      const shouldStick = y > bannerHeight;

      // Fade the logo out linearly between fadeStart and the bottom of the banner.
      // Once sticky, the logo is hidden via CSS so we skip the calculation.
      if (!isSticky) {
        const opacity = y <= fadeStart ? 1 : Math.max(0, 1 - (y - fadeStart) / (bannerHeight - fadeStart));
        if (logoEl) logoEl.style.opacity = String(opacity);
      }

      // Toggle sticky state only on transition to avoid redundant DOM writes on every scroll event.
      if (shouldStick !== isSticky) {
        isSticky = shouldStick;
        banner.classList.toggle('sticky', isSticky);
        // Hold the layout space the banner occupied so page content doesn't jump.
        spacer.style.height = isSticky ? `${bannerHeight}px` : '0';
        if (!isSticky && logoEl) logoEl.style.opacity = '1';
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const lightbox = document.getElementById('annonce-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('annonce-lightbox-img') as HTMLImageElement | null;
  const lightboxBtn = document.querySelector('.announcement-lightbox-btn') as HTMLElement | null;
  if (lightbox && lightboxImg && lightboxBtn) {
    const src = lightboxBtn.dataset.src ?? '';
    let pendingLoad: HTMLImageElement | null = null;

    // Preload as soon as the page is ready so the click is instant in most cases
    const preload = new Image();
    preload.src = src;

    lightboxBtn.addEventListener('click', () => {
      if (preload.complete) {
        lightboxImg.src = src;
        lightbox.showModal();
      } else {
        // Still downloading — open dialog and show wait cursor until ready
        lightboxImg.src = '';
        lightboxImg.style.cursor = 'wait';
        lightbox.showModal();
        pendingLoad = preload;
        preload.onload = () => {
          if (pendingLoad === preload) {
            lightboxImg.src = src;
            lightboxImg.style.cursor = '';
            pendingLoad = null;
          }
        };
      }
    });

    lightbox.addEventListener('click', () => {
      if (pendingLoad) {
        pendingLoad.onload = null;
        pendingLoad = null;
        lightboxImg.style.cursor = '';
      }
      lightbox.close();
    });
  }
</script>

<style>
  /* Banner (expanded state) */
  .banner {
    padding: 1.1rem 2rem 0.55rem;
    position: relative;
    z-index: 100;
    box-shadow: var(--shadow-sm);
    overflow: visible;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .banner-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    width: 200px;
    height: 200px;
    object-fit: contain;
    margin-bottom: -80px;
  }

  .banner-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    align-self: flex-start;
    padding-top: 0.4rem;
  }

  .banner-nav-link {
    transition: color 0.2s, transform 0.2s;
  }

  .banner-nav-link:hover {
    color: var(--color-orange);
    transform: scale(1.1);
  }

  .banner-social {
    color: var(--color-white);
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.6));
  }

  .banner-cta {
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--color-white);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    padding: 0.5rem 1rem;
    border-radius: 4px;
  }

  .banner-cta:hover {
    background-color: var(--color-orange);
    color: var(--color-white);
    transform: none;
  }

  /* Sticky navbar — hidden by default */
  .sticky-navbar {
    display: none;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .navbar-link {
    color: var(--color-text);
    font-family: 'Bellefair', serif;
    font-size: 1.05rem;
    transition: color 0.2s;
  }

  .navbar-link:hover {
    color: var(--color-orange);
  }

  .navbar-separator {
    color: var(--color-separator);
    font-size: 1.1rem;
    user-select: none;
  }

  .navbar-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .navbar-social a {
    display: flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .navbar-social a:hover {
    transform: scale(1.1);
  }

  .banner-spacer {
    height: 0;
  }

  .navbar-logo-link {
    display: flex;
    align-items: center;
  }

  .navbar-logo {
    width: 96px;
    height: 96px;
    object-fit: contain;
    margin-bottom: -36px;
  }

  @keyframes slideDown {
    from { transform: translateY(-100%); }
    to { transform: translateY(0); }
  }

  /* Sticky state (scroll-triggered on desktop) */
  .banner.sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 0.96rem 2rem;
    background-image: none !important;
    background-color: var(--color-nav-bg);
    overflow: visible;
    box-shadow: var(--shadow-sm);
    animation: slideDown 0.3s ease-out;
  }

  .banner.sticky .navbar-link {
    font-size: 1.575rem;
  }

  .banner.sticky .navbar-logo-link {
    margin-left: -0.75rem;
  }

  .banner.sticky .navbar-separator {
    font-size: 1.32rem;
  }

  .banner.sticky .logo {
    display: none;
  }

  .banner.sticky .banner-nav {
    display: none;
  }

  .banner.sticky .sticky-navbar {
    display: flex;
  }

  .navbar-sep--phone,
  .navbar-link--phone {
    display: none;
  }

  /* navOnly mode: inner pages without banner (bocaux, crottin, coffrets).
     The header itself becomes the full-width fixed bar — same pattern as .banner.sticky. */
  @media (min-width: 769px) {
    .banner--nav-only {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 0.96rem 2rem;
      background-image: none !important;
      background-color: var(--color-nav-bg);
      box-shadow: var(--shadow-sm);
      z-index: 200;
    }

    .banner--nav-only .sticky-navbar {
      display: flex;
    }

    .banner--nav-only .navbar-link {
      font-size: 1.575rem;
    }

    .banner--nav-only .navbar-logo-link {
      margin-left: -0.75rem;
    }

    .banner--nav-only .navbar-separator {
      font-size: 1.32rem;
    }
  }

  /* Mobile navigation bar - hidden on desktop */
  .mobile-nav-bar {
    display: none;
  }

  .mobile-drawer {
    display: none;
  }

  /* Mobile */
  @media (max-width: 768px) {
    /* Hide desktop sticky navbar on mobile */
    .sticky-navbar {
      display: none !important;
    }

    /* Mobile navigation bar */
    .mobile-nav-bar {
      display: flex;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      padding: 0.75rem 1rem;
      min-height: 96px;
      z-index: 200;
      align-items: center;
      justify-content: space-between;
    }

    .mobile-nav-logo {
      display: flex;
      align-items: center;
    }

    .mobile-nav-logo img {
      width: 141px;
      height: 141px;
      object-fit: contain;
      margin-bottom: -56px;
    }

    .mobile-nav-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      z-index: 1;
    }

    .mobile-action-icon {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.2s;
    }

    .mobile-action-icon:hover {
      opacity: 0.8;
    }

    /* Mobile drawer */
    .mobile-drawer {
      display: block;
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 85vw;
      background-color: var(--color-nav-bg);
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
      z-index: 300;
      overflow-y: auto;
    }

    .mobile-drawer.open {
      transform: translateX(0);
    }

    .drawer-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      padding: 0.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text);
      min-width: 44px;
      min-height: 44px;
      transition: opacity 0.2s;
    }

    .drawer-close:hover {
      opacity: 0.7;
    }

    .drawer-menu {
      list-style: none;
      padding: 5rem 2rem 2rem;
      margin: 0;
    }

    .drawer-menu li {
      margin-bottom: 0.25rem;
      position: relative;
    }

    .drawer-menu li:not(:last-child):not(.drawer-social)::after {
      content: '';
      display: block;
      width: 80%;
      height: 1px;
      background-color: var(--color-separator);
      margin: 0.25rem auto 0;
    }

    .drawer-menu li a {
      display: block;
      padding: 0.5rem 0;
      font-family: 'Bellefair', serif;
      font-size: 1.5rem;
      color: var(--color-text);
      text-decoration: none;
      transition: color 0.2s;
    }

    .drawer-menu li a:hover {
      color: var(--color-orange);
    }

    .drawer-social {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      margin-top: 1.5rem;
      padding: 1rem 0;
    }

    .drawer-social a {
      display: flex !important;
      padding: 0 !important;
      transition: transform 0.2s;
    }

    .drawer-social a:hover {
      transform: scale(1.1);
    }

    /* Hide desktop banner nav and logo on mobile */
    .banner-nav {
      display: none;
    }

    .logo {
      display: none;
    }

    /* Banner: needs height to push content below fixed nav bar */
    .banner {
      padding: 0;
      padding-top: 85px; /* Logo visible height (141 - 56) */
      background-image: none !important;
      box-shadow: none;
    }

    .banner-container {
      max-width: none;
      padding: 0;
      margin: 0;
    }

    .banner--nav-only {
      padding: 0;
      box-shadow: none;
    }
  }

  /* Announcement bar */
  .announcement-spacer {
    height: 1.5rem;
  }

  .announcement-bar {
    background-color: var(--color-dark-bg);
    border-top: 8px solid var(--color-white);
    color: var(--color-white);
  }

  .announcement-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.4rem 2rem;
    color: var(--color-white);
    font-family: var(--font-body);
    text-align: center;
  }

  .announcement-content :global(*) {
    font-family: var(--font-body);
    font-style: normal;
  }

  .announcement-content :global(p) {
    margin: 0;
    line-height: 1.6;
    font-size: 1.2rem;
  }

  .announcement-content :global(strong) { font-weight: bold; }
  .announcement-content :global(em)     { font-style: italic; }
  .announcement-content :global(u)      { text-decoration: underline; }
  .announcement-content :global(s)      { text-decoration: line-through; }
  .announcement-content :global(a)      { color: var(--color-orange); text-decoration: underline; }

  .announcement-content :global(p + p) {
    margin-top: 0.25rem;
  }

  .announcement-link {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-orange);
    text-decoration: underline;
    font-style: italic;
    font-size: 1.2rem;
  }

  .announcement-lightbox-btn {
    display: block;
    margin-top: 0.3rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-orange);
    text-decoration: underline;
    font-size: 1.2rem;
    font-family: var(--font-body);
    text-align: center;
    width: 100%;
  }

  #annonce-lightbox {
    padding: 0;
    background: transparent;
    border: none;
    outline: none;
    width: 90vw;
    height: 90vh;
    position: fixed;
