---
import { Image } from 'astro:assets';
import logoCrottin from '../assets/images/logo_crottin_noir.png';
import logoBocal from '../assets/images/logo_bocal.png';
---

<section class="hero-circles">
  <div class="circles-container">
    <a href="/bocaux" class="circle">
      <span class="circle-title circle-title-nowrap">Les bocaux</span>
      <div class="circle-icon">
        <Image src={logoBocal} alt="Bocal" width={92} height={92} />
      </div>
    </a>

    <a href="/">
      <Image src={logoCrottin} alt="Le Crottin Craonnais — Chocolat Artisanal Fabrice Sorin" width={264} height={264} class="circle-image" />
    </a>

    <a href="/" class="circle">
      <span class="circle-title">Les coffrets gourmands</span>
      <div class="circle-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="88" height="88" viewBox="0 0 24 24" fill="white" stroke="black" stroke-width="0.750" stroke-linecap="round" stroke-linejoin="round">
          <path d="M 20 12 L 20 20.5 A 1.5 1.5 0 0 1 18.5 22 L 5.5 22 A 1.5 1.5 0 0 1 4 20.5 L 4 12"></path>
          <rect x="2" y="7" width="20" height="5" rx="1.5"></rect>
          <line x1="12" y1="22" x2="12" y2="7"></line>
          <path fill="#F29D37" d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
          <path fill="#F29D37" d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
        </svg>
      </div>
    </a>
  </div>
</section>

<style>
  .hero-circles {
    background-color: var(--color-white);
    padding: 1.2rem 2rem 0;
  }

  .circles-container {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .circle {
    width: 264px;
    height: 264px;
    background-color: var(--color-orange);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.8rem;
    text-align: center;
    color: var(--color-white);
    box-shadow: 0 0 18px 6px rgba(0, 0, 0, 0);
    transition: box-shadow 0.2s ease-out;
  }

  .circle:hover {
    box-shadow: 0 0 18px 6px rgba(0, 0, 0, 0.45);
    transition: box-shadow 0.2s ease-in;
  }

  .circle-image {
    width: 264px;
    height: 264px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 21px 7px rgba(0, 0, 0, 0);
    transition: box-shadow 0.2s ease-out;
  }

  .circle-image:hover {
    box-shadow: 0 0 21px 7px rgba(0, 0, 0, 0.54);
    transition: box-shadow 0.2s ease-in;
  }

  .circle-title {
    font-family: 'Dancing Script', cursive;
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.05;
    margin-bottom: 0.5rem;
    text-decoration: underline;
    text-decoration-color: black;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .circle-title-nowrap {
    white-space: nowrap;
  }

  .circle-icon {
    width: 92px;
    height: 92px;
    margin: 0.5rem 0;
  }

  @media (max-width: 768px) {
    .hero-circles {
      display: none;
    }

    .circles-container {
      gap: 1.5rem;
    }

    .circle {
      width: 216px;
      height: 216px;
      padding: 1.2rem;
    }

    .circle-image {
      width: 216px;
      height: 216px;
    }

    .circle-title {
      font-size: 1.7rem;
    }

    .circle-icon {
      width: 66px;
      height: 66px;
    }
  }
</style>
