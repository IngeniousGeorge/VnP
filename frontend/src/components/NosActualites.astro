---
const externalLinkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`;
---

<section class="nos-actualites">
  <h2 class="actu-title">Nos actualités</h2>

  <div class="actu-carousel">
    <!-- Chevron kept for reintroduction with the post feed — hidden for now -->
    <button class="actu-btn actu-btn--prev" aria-label="Publication précédente" disabled>
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>

    <div class="actu-viewport">
      <div class="actu-track">

        <!-- Facebook CTA card -->
        <article class="actu-card">
          <div class="actu-cta-fb">
            <svg class="actu-cta-icon" width="36" height="36" viewBox="0 0 24 24" fill="white">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <p class="actu-cta-text">Retrouvez-nous sur Facebook</p>
            <a href="https://www.facebook.com/verreetpapilles" target="_blank" rel="noopener noreferrer" class="actu-cta-btn">
              Suivez-nous
              <Fragment set:html={externalLinkIcon} />
            </a>
          </div>
        </article>

        <!-- Instagram CTA card -->
        <article class="actu-card">
          <div class="actu-cta-ig">
            <svg class="actu-cta-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            <p class="actu-cta-text">Ou sur Instagram</p>
            <a href="https://www.instagram.com/verre_et_papilles" target="_blank" rel="noopener noreferrer" class="actu-cta-btn actu-cta-btn--ig">
              Suivez-nous
              <Fragment set:html={externalLinkIcon} />
            </a>
          </div>
        </article>

      </div>
    </div>

    <!-- Chevron kept for reintroduction with the post feed — hidden for now -->
    <button class="actu-btn actu-btn--next" aria-label="Publication suivante">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </button>
  </div>
</section>

<style>
  .nos-actualites {
    background-color: var(--color-dark-bg);
    padding: 4rem 2rem;
  }

  .actu-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 2rem;
  }

  .actu-carousel {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Temporarily hidden — kept for reintroduction with the post feed */
  .actu-btn {
    visibility: hidden;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--color-orange);
    transition: color 0.2s;
    flex-shrink: 0;
  }

  .actu-btn:hover:not(:disabled) {
    color: var(--color-orange-dark);
  }

  .actu-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .actu-viewport {
    overflow: hidden;
    flex: 1;
  }

  .actu-track {
    display: flex;
    transition: transform 0.4s ease-in-out;
  }

  .actu-card {
    flex: 0 0 33.333%;
    padding: 0 0.5rem;
    min-width: 0;
  }

  /* CTA cards */
  .actu-cta-fb,
  .actu-cta-ig {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 1.5rem;
    border-radius: 8px;
    min-height: 280px;
  }

  .actu-cta-fb {
    background-color: var(--color-facebook);
  }

  .actu-cta-ig {
    background: var(--gradient-instagram);
  }

  .actu-cta-icon {
    margin-bottom: 0.75rem;
  }

  .actu-cta-text {
    color: var(--color-white);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .actu-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-white);
    color: var(--color-facebook);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.5rem 1.2rem;
    border-radius: 6px;
    transition: background-color 0.2s;
  }

  .actu-cta-btn:hover {
    background-color: var(--color-facebook-light);
  }

  .actu-cta-btn--ig {
    color: var(--color-instagram-pink);
  }

  @media (max-width: 768px) {
    .nos-actualites {
      padding: 3rem 1rem;
    }

    .actu-title {
      font-size: 1.75rem;
    }

    .actu-carousel {
      max-width: 100%;
      gap: 0.5rem;
    }

    .actu-card {
      flex: 0 0 100%;
      padding: 0;
    }

    .actu-btn svg {
      width: 22px;
      height: 22px;
    }
  }
</style>

<script>
  const section = document.querySelector('.nos-actualites') as HTMLElement;
  const track = section.querySelector('.actu-track') as HTMLElement;
  const prevBtn = section.querySelector('.actu-btn--prev') as HTMLButtonElement;
  const nextBtn = section.querySelector('.actu-btn--next') as HTMLButtonElement;
  const totalSlides = track.children.length;
  const mobileQuery = window.matchMedia('(max-width: 768px)');
  let current = 0;

  // Center the track when there are fewer cards than the number of visible slots,
  // so partial fills don't appear left-aligned. Reverts to default (flex-start)
  // when enough cards exist to fill or overflow the viewport.
  const visibleCount = mobileQuery.matches ? 1 : 3;
  if (totalSlides < visibleCount) {
    track.style.justifyContent = 'center';
  }

  function getSlidePercent() {
    return mobileQuery.matches ? 100 : 100 / 3;
  }

  function getMaxIndex() {
    const visible = mobileQuery.matches ? 1 : 3;
    return totalSlides - visible;
  }

  function updateCarousel() {
    track.style.transform = `translateX(-${current * getSlidePercent()}%)`;
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current >= getMaxIndex();
  }

  updateCarousel();

  // Event delegation — chevrons are currently hidden but wired up for when
  // the post feed is reintroduced and the buttons are made visible again.
  section.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.actu-btn') as HTMLButtonElement | null;
    if (!btn || btn.disabled) return;

    if (btn.classList.contains('actu-btn--next')) {
      current = Math.min(current + 1, getMaxIndex());
    } else {
      current = Math.max(current - 1, 0);
    }
    updateCarousel();
  });
</script>
